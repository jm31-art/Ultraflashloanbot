# ==========================================
# MONEY TREES PRINTER 2025 - ENVIRONMENT CONFIG
# ==========================================

# 🔑 REQUIRED: Separate wallets for each bot to prevent nonce conflicts

# Python High-Frequency Bot Wallet
PYTHON_BOT_PRIVATE_KEY=8672cf4a0a6a27808073019a36272b412f876505af023e15a90c28001ae32a26
PYTHON_BOT_ADDRESS=0xe86e398ace47a45aa6ace4014c5ba3e81ae20f8b
PYTHON_BOT_MIN_BNB=0.005

# JavaScript Liquidation Bot Wallet (DIFFERENT from Python bot!)
LIQUIDATION_BOT_KEY=45cfa7bf0cd2164b8d4baa3e1de69acfa56324f8e0bfc34d9b024c59e27db463
LIQUIDATION_BOT_ADDRESS=0xe93aeb5693475a02b84021f5f26f0eca4547db32
LIQUIDATION_BOT_MIN_BNB=0.005

# Emergency/Admin Wallet (funds other wallets if needed)
ADMIN_PRIVATE_KEY=0xYOUR_ADMIN_PRIVATE_KEY_HERE
ADMIN_ADDRESS=0xYOUR_ADMIN_ADDRESS_HERE

# 📱 OPTIONAL: Telegram Notifications
# Create a bot at @BotFather and get the token
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Get chat ID by messaging your bot and checking updates
TELEGRAM_CHAT_ID=your_chat_id_here

# 🌐 OPTIONAL: Custom RPC Endpoints
# Default uses Merkle.io for private mempool access
MERKLE_RPC=https://bsc.merkle.io
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# ⚙️ OPTIONAL: Advanced Settings
BSC_MAX_GAS_PRICE=50000000000  # 50 gwei max gas price

# 📄 CONTRACT ADDRESSES
FLASH_LOAN_CONTRACT=0xYOUR_FLASH_LOAN_CONTRACT_ADDRESS_HERE
FLASH_ARB_ADDRESS=0xYOUR_FLASH_ARB_CONTRACT_ADDRESS_HERE

# 🛡️ MEV PROTECTION
MEV_PROTECTION_ENABLED=true

# � SECURITY: Never commit real values to Git!
# This file is safe to commit - copy to .env and fill in real values
# Each wallet must have at least 0.1 BNB for gas fees
# Admin wallet should have sufficient funds to rescue stuck transactions